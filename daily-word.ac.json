{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "🌙 Günün Kelimesi", "size": "small", "isSubtle": true },
    { "type": "TextBlock", "text": "${word}", "size": "extraLarge", "weight": "bolder", "wrap": true },
    { "type": "TextBlock", "text": "${translation}", "size": "medium", "wrap": true, "spacing": "none" }
  ],
  "actions": [
    { "type": "Action.OpenUrl", "title": "Çalışmaya başla", "url": "${deepLink}" }
  ]
}
