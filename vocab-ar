add("ar","B2","Sağlık Fiilleri","يحسن","iyileştirmek","fiil","تساعد الرياضة على تحسين الصحة.","Spor sağlığı iyileştirmeye yardımcı olur.");
add("ar","B2","Sağlık Fiilleri","يقوي","güçlendirmek","fiil","يساعد النظام الغذائي الجيد على تقوية الجسم.","İyi beslenme vücudu güçlendirmeye yardımcı olur.");
add("ar","B2","Sağlık Fiilleri","يقلل من","azaltmak","fiil","تقلل الرياضة من خطر الإصابة.","Spor yaralanma riskini azaltır.");
// ======================= B2 — YAŞAM TARZI =======================
add("ar","B2","Yaşam Tarzı","نمط حياة","yaşam tarzı","isim","يتبع نمط حياة صحيا.","Sağlıklı bir yaşam tarzı sürdürüyor.");
add("ar","B2","Yaşam Tarzı","نظام غذائي","beslenme düzeni / diyet","isim","يتبع نظاما غذائيا متوازنا.","Dengeli bir beslenme düzeni uyguluyor.");
add("ar","B2","Yaşam Tarzı","تغذية","beslenme","isim","تؤثر التغذية في صحة الإنسان.","Beslenme insan sağlığını etkiler.");
add("ar","B2","Yaşam Tarzı","غذاء متوازن","dengeli beslenme","isim","يحتاج الأطفال إلى غذاء متوازن.","Çocukların dengeli beslenmeye ihtiyacı var.");
add("ar","B2","Yaşam Tarzı","نشاط بدني","fiziksel aktivite","isim","تساعد الأنشطة البدنية على تحسين الصحة.","Fiziksel aktiviteler sağlığı iyileştirmeye yardımcı olur.");
add("ar","B2","Yaşam Tarzı","تمرين","egzersiz","isim","يمارس التمارين الرياضية بانتظام.","Düzenli olarak egzersiz yapıyor.");
add("ar","B2","Yaşam Tarzı","قلة النوم","uyku eksikliği","isim","تؤثر قلة النوم في التركيز.","Uyku eksikliği konsantrasyonu etkiler.");
add("ar","B2","Yaşam Tarzı","إرهاق","yorgunluk","isim","يشعر بإرهاق شديد بعد العمل.","İşten sonra şiddetli yorgunluk hissediyor.");
add("ar","B2","Yaşam Tarzı","توتر","stres","isim","يسبب العمل المستمر التوتر.","Sürekli çalışmak strese neden oluyor.");
add("ar","B2","Yaşam Tarzı","قلق","kaygı","isim","يعاني من القلق قبل الامتحان.","Sınavdan önce kaygı yaşıyor.");
add("ar","B2","Yaşam Tarzı","راحة","dinlenme","isim","يحتاج الجسم إلى الراحة.","Vücudun dinlenmeye ihtiyacı vardır.");
add("ar","B2","Yaşam Tarzı","عادات صحية","sağlıklı alışkanlıklar","isim","يجب أن نطور عادات صحية.","Sağlıklı alışkanlıklar geliştirmeliyiz.");
add("ar","B2","Yaşam Tarzı","إدمان","bağımlılık","isim","يحتاج علاج الإدمان إلى دعم متخصص.","Bağımlılığın tedavisi uzman desteği gerektirir.");
add("ar","B2","Yaşam Tarzı","تدخين","sigara içme","isim","يزيد التدخين من خطر الإصابة بالأمراض.","Sigara içmek hastalık riskini artırır.");
add("ar","B2","Yaşam Tarzı","سمنة","obezite","isim","تزداد معدلات السمنة في بعض الدول.","Bazı ülkelerde obezite oranları artıyor.");
// ======================= B2 — TOPLUM SAĞLIĞI =======================
add("ar","B2","Toplum Sağlığı","صحة عامة","halk sağlığı","isim","تحتاج الصحة العامة إلى استثمارات مستمرة.","Halk sağlığı sürekli yatırımlara ihtiyaç duyar.");
add("ar","B2","Toplum Sağlığı","توعية صحية","sağlık bilgilendirmesi / farkındalığı","isim","تنظم الوزارة حملات توعية صحية.","Bakanlık sağlık farkındalığı kampanyaları düzenliyor.");
add("ar","B2","Toplum Sağlığı","وقاية من الأمراض","hastalıklardan korunma","isim","تعد الوقاية من الأمراض أولوية.","Hastalıklardan korunma bir önceliktir.");
add("ar","B2","Toplum Sağlığı","انتشار المرض","hastalığın yayılması","isim","تعمل السلطات على الحد من انتشار المرض.","Yetkililer hastalığın yayılmasını azaltmak için çalışıyor.");
add("ar","B2","Toplum Sağlığı","وباء","salgın","isim","أعلنت السلطات عن انتشار وباء جديد.","Yetkililer yeni bir salgının yayıldığını duyurdu.");
add("ar","B2","Toplum Sağlığı","جائحة","pandemi","isim","غيرت الجائحة طريقة الحياة في جميع أنحاء العالم.","Pandemi dünya genelinde yaşam biçimini değiştirdi.");
add("ar","B2","Toplum Sağlığı","رعاية أولية","birinci basamak sağlık hizmeti","isim","توفر المراكز الصحية الرعاية الأولية.","Sağlık merkezleri birinci basamak sağlık hizmeti sunuyor.");
add("ar","B2","Toplum Sağlığı","تأمين صحي","sağlık sigortası","isim","لديه تأمين صحي شامل.","Kapsamlı sağlık sigortası var.");
add("ar","B2","Toplum Sağlığı","تكلفة العلاج","tedavi maliyeti","isim","ارتفعت تكلفة العلاج بشكل كبير.","Tedavi maliyeti önemli ölçüde arttı.");
add("ar","B2","Toplum Sağlığı","إمكانية الوصول إلى الرعاية الصحية","sağlık hizmetlerine erişim","isim","يجب تحسين إمكانية الوصول إلى الرعاية الصحية.","Sağlık hizmetlerine erişim iyileştirilmelidir.");
add("ar","B2","Toplum Sağlığı","فجوة صحية","sağlık eşitsizliği","isim","توجد فجوة صحية بين المناطق المختلفة.","Farklı bölgeler arasında sağlık eşitsizliği var.");
add("ar","B2","Toplum Sağlığı","خدمات طبية","tıbbi hizmetler","isim","تحتاج المناطق الريفية إلى خدمات طبية أفضل.","Kırsal bölgelerin daha iyi tıbbi hizmetlere ihtiyacı var.");
add("ar","B2","Toplum Sağlığı","رعاية المسنين","yaşlı bakımı","isim","تحتاج رعاية المسنين إلى موارد إضافية.","Yaşlı bakımı ek kaynaklara ihtiyaç duyuyor.");
add("ar","B2","Toplum Sağlığı","الصحة النفسية","ruh sağlığı","isim","أصبحت الصحة النفسية موضوعا مهما.","Ruh sağlığı önemli bir konu haline geldi.");
add("ar","B2","Toplum Sağlığı","دعم نفسي","psikolojik destek","isim","يحتاج بعض المرضى إلى دعم نفسي.","Bazı hastaların psikolojik desteğe ihtiyacı var.");
// ======================= B2 — SAĞLIK SIFATLARI =======================
add("ar","B2","Sağlık Sıfatları","صحي","sağlıklı","sıfat","يتبع نظاما صحيا ومتوازنا.","Sağlıklı ve dengeli bir beslenme düzeni uyguluyor.");
add("ar","B2","Sağlık Sıfatları","مزمن","kronik","sıfat","يعاني من مرض مزمن.","Kronik bir hastalıktan muzdarip.");
add("ar","B2","Sağlık Sıfatları","معد","bulaşıcı","sıfat","هذا المرض معد للغاية.","Bu hastalık oldukça bulaşıcıdır.");
add("ar","B2","Sağlık Sıfatları","خطير","ciddi / tehlikeli","sıfat","قد تكون الحالة الصحية خطيرة.","Sağlık durumu ciddi olabilir.");
add("ar","B2","Sağlık Sıfatları","فعال","etkili","sıfat","هذا علاج فعال.","Bu etkili bir tedavidir.");
add("ar","B2","Sağlık Sıfatları","وقائي","koruyucu","sıfat","يستخدم الدواء لأغراض وقائية.","İlaç koruyucu amaçlarla kullanılıyor.");
add("ar","B2","Sağlık Sıfatları","نفسي","psikolojik","sıfat","يحتاج إلى دعم نفسي.","Psikolojik desteğe ihtiyacı var.");
add("ar","B2","Sağlık Sıfatları","جسدي","fiziksel","sıfat","يمكن أن يسبب المرض آثارا جسدية.","Hastalık fiziksel etkilere neden olabilir.");
add("ar","B2","Sağlık Sıfatları","طبي","tıbbi","sıfat","يحتاج إلى رعاية طبية.","Tıbbi bakıma ihtiyacı var.");
add("ar","B2","Sağlık Sıfatları","عاجل","acil","sıfat","هذه حالة طبية عاجلة.","Bu acil bir tıbbi durumdur.");
add("ar","B2","Sağlık Sıfatları","متوازن","dengeli","sıfat","يجب اتباع نظام غذائي متوازن.","Dengeli bir beslenme düzeni uygulanmalıdır.");
add("ar","B2","Sağlık Sıfatları","مفرط","aşırı","sıfat","الاستهلاك المفرط للسكر ضار.","Aşırı şeker tüketimi zararlıdır.");
add("ar","B2","Sağlık Sıfatları","مفيد","faydalı","sıfat","النشاط البدني مفيد للصحة.","Fiziksel aktivite sağlık için faydalıdır.");
add("ar","B2","Sağlık Sıfatları","ضار","zararlı","sıfat","التدخين ضار بالصحة.","Sigara içmek sağlığa zararlıdır.");
add("ar","B2","Sağlık Sıfatları","طبيعي","doğal","sıfat","يفضل بعض الناس العلاج الطبيعي.","Bazı insanlar doğal tedaviyi tercih ediyor.");
// ======================= B2 — SAĞLIK İFADELERİ =======================
add("ar","B2","Sağlık İfadeleri","يؤدي إلى","... yol açmak","ifade","قد يؤدي نقص النوم إلى مشاكل صحية.","Uyku eksikliği sağlık sorunlarına yol açabilir.");
add("ar","B2","Sağlık İfadeleri","يزيد من خطر","riskini artırmak","ifade","يزيد التدخين من خطر الإصابة بالسرطان.","Sigara içmek kanser riskini artırır.");
add("ar","B2","Sağlık İfadeleri","يقلل من خطر","riskini azaltmak","ifade","تقلل الرياضة من خطر الإصابة بأمراض القلب.","Spor kalp hastalıkları riskini azaltır.");
add("ar","B2","Sağlık İfadeleri","يعتمد العلاج على","tedavi ... bağlıdır","ifade","يعتمد العلاج على نوع المرض.","Tedavi hastalığın türüne bağlıdır.");
add("ar","B2","Sağlık İfadeleri","يخضع للمراقبة الطبية","tıbbi gözetim altında olmak","ifade","يخضع المريض للمراقبة الطبية.","Hasta tıbbi gözetim altında.");
add("ar","B2","Sağlık İfadeleri","يتطلب عناية خاصة","özel bakım gerektirmek","ifade","تتطلب الحالة عناية خاصة.","Durum özel bakım gerektiriyor.");
add("ar","B2","Sağlık İfadeleri","من الضروري اتباع","uyulması gereklidir","ifade","من الضروري اتباع تعليمات الطبيب.","Doktorun talimatlarına uyulması gereklidir.");
add("ar","B2","Sağlık İfadeleri","الحفاظ على صحة جيدة","iyi sağlığı korumak","ifade","يساعد النوم الكافي على الحفاظ على صحة جيدة.","Yeterli uyku iyi sağlığın korunmasına yardımcı olur.");
add("ar","B2","Sağlık İfadeleri","الحد من انتشار","yayılmasını azaltmak","ifade","تساعد الإجراءات الوقائية على الحد من انتشار المرض.","Önleyici tedbirler hastalığın yayılmasını azaltmaya yardımcı olur.");
add("ar","B2","Sağlık İfadeleri","رفع الوعي الصحي","sağlık bilincini artırmak","ifade","تهدف الحملة إلى رفع الوعي الصحي.","Kampanya sağlık bilincini artırmayı amaçlıyor.");
add("ar","B2","Sağlık İfadeleri","الوصول إلى العلاج","tedaviye erişmek","ifade","يجب ضمان وصول الجميع إلى العلاج.","Herkesin tedaviye erişimi garanti edilmelidir.");
add("ar","B2","Sağlık İfadeleri","تحسين جودة الحياة","yaşam kalitesini iyileştirmek","ifade","تهدف التكنولوجيا الطبية إلى تحسين جودة الحياة.","Tıbbi teknoloji yaşam kalitesini iyileştirmeyi amaçlıyor.");
add("ar","B2","Sağlık İfadeleri","الوقاية من المرض","hastalığı önlemek","ifade","الوقاية من المرض أفضل من علاجه.","Hastalığı önlemek tedavi etmekten daha iyidir.");
add("ar","B2","Sağlık İfadeleri","التعامل مع المرض","hastalıkla başa çıkmak","ifade","يتعلم المريض كيفية التعامل مع المرض.","Hasta hastalıkla nasıl başa çıkacağını öğreniyor.");
add("ar","B2","Sağlık İfadeleri","اتباع نمط حياة صحي","sağlıklı bir yaşam tarzı sürdürmek","ifade","يساعد اتباع نمط حياة صحي على الوقاية من الأمراض.","Sağlıklı bir yaşam tarzı sürdürmek hastalıkları önlemeye yardımcı olur.");
