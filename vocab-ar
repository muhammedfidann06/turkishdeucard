// ======================= B2 — ÇEVRE =======================
add("ar","B2","Çevre","بيئة","çevre","isim","يجب علينا حماية البيئة للأجيال القادمة.","Gelecek nesiller için çevreyi korumalıyız.");
add("ar","B2","Çevre","تلوث","kirlilik","isim","تعاني المدن الكبرى من تلوث الهواء.","Büyük şehirler hava kirliliğinden muzdarip.");
add("ar","B2","Çevre","تلوث الهواء","hava kirliliği","isim","يؤثر تلوث الهواء في صحة الإنسان.","Hava kirliliği insan sağlığını etkiliyor.");
add("ar","B2","Çevre","تلوث المياه","su kirliliği","isim","تسبب المصانع في تلوث المياه.","Fabrikalar su kirliliğine neden oldu.");
add("ar","B2","Çevre","نفايات","atıklar","isim","تنتج المدن كميات كبيرة من النفايات.","Şehirler büyük miktarda atık üretiyor.");
add("ar","B2","Çevre","نفايات بلاستيكية","plastik atıklar","isim","تسبب النفايات البلاستيكية أضرارا كبيرة للبحار.","Plastik atıklar denizlere büyük zarar veriyor.");
add("ar","B2","Çevre","إعادة التدوير","geri dönüşüm","isim","تساعد إعادة التدوير على تقليل النفايات.","Geri dönüşüm atıkların azaltılmasına yardımcı olur.");
add("ar","B2","Çevre","إزالة الغابات","ormansızlaşma","isim","تؤدي إزالة الغابات إلى فقدان التنوع البيولوجي.","Ormansızlaşma biyolojik çeşitliliğin kaybına yol açıyor.");
add("ar","B2","Çevre","غابة","orman","isim","تغطي الغابات جزءا كبيرا من المنطقة.","Ormanlar bölgenin büyük bir bölümünü kaplıyor.");
add("ar","B2","Çevre","موارد طبيعية","doğal kaynaklar","isim","يجب استخدام الموارد الطبيعية بحكمة.","Doğal kaynaklar akıllıca kullanılmalı.");
add("ar","B2","Çevre","تنوع بيولوجي","biyolojik çeşitlilik","isim","يهدد التلوث التنوع البيولوجي.","Kirlilik biyolojik çeşitliliği tehdit ediyor.");
add("ar","B2","Çevre","نظام بيئي","ekosistem","isim","يعتمد هذا النظام البيئي على التوازن الطبيعي.","Bu ekosistem doğal dengeye dayanıyor.");
add("ar","B2","Çevre","توازن بيئي","ekolojik denge","isim","يجب الحفاظ على التوازن البيئي.","Ekolojik denge korunmalıdır.");
add("ar","B2","Çevre","حماية البيئة","çevre koruma","isim","تحتاج حماية البيئة إلى جهود مشتركة.","Çevre koruma ortak çabalar gerektirir.");
add("ar","B2","Çevre","كارثة طبيعية","doğal afet","isim","تسببت العاصفة في كارثة طبيعية كبيرة.","Fırtına büyük bir doğal afete neden oldu.");
