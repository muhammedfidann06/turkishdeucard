add("ar","B2","İklim","تغير المناخ","iklim değişikliği","isim","يعد تغير المناخ من أكبر التحديات الحالية.","İklim değişikliği günümüzdeki en büyük zorluklardan biridir.");
add("ar","B2","İklim","احتباس حراري","küresel ısınma","isim","يؤدي الاحتباس الحراري إلى ارتفاع درجات الحرارة.","Küresel ısınma sıcaklıkların yükselmesine neden oluyor.");
add("ar","B2","İklim","انبعاثات","emisyonlar","isim","يجب تقليل انبعاثات الكربون.","Karbon emisyonları azaltılmalı.");
add("ar","B2","İklim","غازات الدفيئة","sera gazları","isim","تزيد غازات الدفيئة من ظاهرة الاحتباس الحراري.","Sera gazları küresel ısınmayı artırıyor.");
add("ar","B2","İklim","ثاني أكسيد الكربون","karbondioksit","isim","تنتج السيارات كميات كبيرة من ثاني أكسيد الكربون.","Arabalar büyük miktarda karbondioksit üretiyor.");
add("ar","B2","İklim","ارتفاع درجات الحرارة","sıcaklıkların yükselmesi","isim","يسبب ارتفاع درجات الحرارة مشاكل عديدة.","Sıcaklıkların yükselmesi birçok soruna neden oluyor.");
add("ar","B2","İklim","ذوبان الجليد","buzulların erimesi","isim","يهدد ذوبان الجليد المناطق الساحلية.","Buzulların erimesi kıyı bölgelerini tehdit ediyor.");
add("ar","B2","İklim","ارتفاع مستوى سطح البحر","deniz seviyesinin yükselmesi","isim","يؤدي تغير المناخ إلى ارتفاع مستوى سطح البحر.","İklim değişikliği deniz seviyesinin yükselmesine neden oluyor.");
add("ar","B2","İklim","جفاف","kuraklık","isim","تعاني المنطقة من جفاف شديد.","Bölge şiddetli kuraklık yaşıyor.");
add("ar","B2","İklim","فيضانات","sel / seller","isim","تسببت الأمطار الغزيرة في فيضانات.","Şiddetli yağışlar sellere neden oldu.");
add("ar","B2","İklim","عاصفة","fırtına","isim","اقتربت عاصفة قوية من الساحل.","Güçlü bir fırtına kıyıya yaklaştı.");
add("ar","B2","İklim","موجة حر","sıcak hava dalgası","isim","شهدت البلاد موجة حر غير مسبوقة.","Ülke eşi benzeri görülmemiş bir sıcak hava dalgası yaşadı.");
add("ar","B2","İklim","ظاهرة طبيعية","doğal olay","isim","هذه ظاهرة طبيعية نادرة.","Bu nadir bir doğal olaydır.");
add("ar","B2","İklim","توقعات الطقس","hava tahmini","isim","تتوقع الأرصاد الجوية أمطارا غزيرة.","Meteoroloji şiddetli yağış bekliyor.");
