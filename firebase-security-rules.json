{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null",
      ".write": false
    },

    "leaderboard": {
      ".read": true,
      "//": "read KASITLI public: leaderboard.js listenLeaderboard() acilista (girissiz de) tabloyu okuyor. uid+isim+xp+sure aciga cikar; bir liderlik tablosu icin kabul edilebilir. Sadece girisli gostereceksen 'auth != null' yap.",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "totalSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() >= data.val())"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() >= data.val())"
        },
        "lastFlushAttempt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "progress": {
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "meta": {
          "xp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() >= data.val())"
          }
        }
      }
    },

    "banned": {
      "//": "read DEGISTIRILDI: eskiden 'auth != null' → girisli HERKES yasaklilarin yedeklenmis progress/leaderboard verisini okuyabiliyordu. Artik yalniz yonetici.",
      ".read":  "root.child('admins').child(auth.uid).val() === true",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "analytics": {
      "//": "write DEGISTIRILDI: eskiden her yaprakta '.write': true → internetteki HERKES kimliksiz yazabiliyordu (sayac bozma + sinirsiz anahtar spam = kota/fatura DoS). Artik: giris sart + deger negatif olmayan sayi + $day gercek tarih olmali.",
      "//2": "UYARI: analytics.js pakette yok, auth baglamini goremedim. Analytics GIRISSIZ kullanicilar icin de yaziyorsa bu kural onlari engeller. Dogru cozum Firebase App Check (RTDB'de zorunlu kil).",
      ".read": "root.child('admins').child(auth.uid).val() === true",
      "events": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$event": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      },
      "dau": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$user": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      },
      "funnel": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$step": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      },
      "sessions": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$field": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      }
    }
  }
}
